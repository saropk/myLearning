# Copy this file to `.env` and fill in your values, then load it before running
# (e.g. `export $(grep -v '^#' .env | xargs)` or use a tool like direnv).

# Required for the Claude brain (open-ended questions). Without it Athena still
# runs, but only the built-in skills work.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional overrides (defaults shown) ---
# ATHENA_NAME=Athena
# ATHENA_OWNER=Saro
# ATHENA_WAKE_WORD=athena
# ATHENA_VOICE=Samantha           # any installed macOS voice (try "Alex", "Karen")
# ATHENA_SPEECH_RATE=180
# ATHENA_MODEL=claude-opus-4-8    # the Claude model used for the brain
# ATHENA_USE_LLM=true             # set false to force rule-based only
